// Copy this file to wifi_secrets.h (gitignored, never committed) and fill
// in real values to auto-provision WiFi at first boot instead of entering
// credentials via the on-device encoder character picker every time NVS
// gets wiped (e.g. reflashing with a different partition table - see the
// "launcher guest" env in platformio.ini).
//
// Only takes effect if no WiFi credentials are already saved (won't
// override anything entered on-device). Optional - if wifi_secrets.h
// doesn't exist, nothing changes.
#pragma once

#define WIFI_DEFAULT_SSID     "YourNetworkName"
#define WIFI_DEFAULT_PASSWORD "YourPassword"
